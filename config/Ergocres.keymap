#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE        &kp N1                &kp N2             &kp N3    &kp N4     &kp N5           &kp N6                       &kp N7                       &kp N8                          &kp N9    &kp N0     &kp MINUS
&kp TAB           &kp Q                 &kp W              &kp E     &kp R      &kp T            &kp Y                        &kp U                        &kp I                           &kp O     &kp P      &kp EQUAL
&kp LEFT_SHIFT    &kp A                 &kp S              &kp D     &kp F      &kp G            &kp H                        &kp J                        &kp K                           &kp L     &kp SEMI   &kp SQT
&kp LEFT_COMMAND  &kp Z                 &kp X              &kp C     &kp V      &kp B            &kp N                        &kp M                        &kp COMMA                       &kp DOT   &kp FSLH   &kp MINUS
&kp LS(LG(LEFT))  &kp LS(LG(UP_ARROW))  &kp LS(LG(RIGHT))  &mkp MB2  &kp RCTRL  &kp BACKSPACE    &lt_to_layer_0 1 LANGUAGE_2  &lt_to_layer_0 2 LANGUAGE_1  &lt_to_layer_0 3 C_RANDOM_PLAY  &mkp MB1  &kp SPACE  &lt 3 ENTER
            >;
        };

        layer_1 {
            bindings = <
&kp F1    &kp F2          &kp F3          &kp F4           &kp F5   &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11   &kp F12
&kp HOME  &trans          &kp UP_ARROW    &trans           &kp END  &trans    &trans  &trans  &trans  &trans   &kp LBKT  &kp RBKT
&trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans    &trans  &trans  &trans  &trans   &trans    &trans
&trans    &trans          &trans          &trans           &trans   &trans    &trans  &trans  &trans  &trans   &trans    &trans
&trans    &trans          &trans          &trans           &trans   &trans    &trans  &trans  &trans  &trans   &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans  &trans  &trans    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE   &kp UP_ARROW              &kp RET
&trans        &trans        &trans  &trans  &trans  &trans    &trans           &trans           &trans           &kp LEFT_ARROW  &kp DOWN_ARROW            &kp RIGHT_ARROW
&trans        &trans        &trans  &trans  &trans  &trans    &trans           &trans           &trans           &kp ASTRK       &kp KP_RIGHT_PARENTHESIS  &kp KP_DOT
&trans        &trans        &trans  &trans  &trans  &trans    &trans           &trans           &trans           &kp ASTERISK    &kp KP_SLASH              &kp KP_ENTER
&trans        &trans        &trans  &trans  &trans  &trans    &trans           &trans           &trans           &trans          &trans                    &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        scroll {
            if-layers = <3>;
            then-layer = <3>;
        };
    };
};
